def cmd_auth(args):
    if args.op == "status":
        kind, label = token_source()
        hint = ""
        if kind:
            try:
                t = token()
                # Enough to recognise which token is in use, not enough to use.
                hint = (t[:4] + "…" + t[-4:]) if len(t) > 12 else "…"
            except Exception:
                kind = None
        return {"ok": True, "configured": bool(kind), "sourceKind": kind or "",
                "source": label, "own": kind in ("keyring", "file"),
                "hint": hint, "keyring": keyring_available(),
                "wfConfig": WF_CONFIG, "tokenFile": TOKEN_FILE}

    if args.op == "clear":
        # Clear both stores: leaving one behind would make "Forget" a lie.
        keyring_clear()
        try:
            os.remove(TOKEN_FILE)
        except OSError as e:
            if e.errno != errno.ENOENT:
                return {"ok": False, "error": str(e)}
        return {"ok": True, "cleared": True}

    # set: the token arrives on STDIN, never argv -- an argument would be
    # visible to every other user on the machine via `ps`. This mirrors what
    # omarchy.network does for wifi passwords.
    # readline(), NOT read(). read() waits for EOF, and the QML side writes
    # the token with Process.write() without ever closing the pipe -- so the
    # helper blocked on the read forever and the panel sat on "Checking...".
    # The token is a single line; one line is all this needs.
    raw = sys.stdin.readline().strip()
    if not raw:
        return {"ok": False, "error": "no token received"}
    if len(raw) < 20 or " " in raw:
        return {"ok": False, "error": "that does not look like a Workflowy API token"}

    # Prove it works before storing it, so a typo surfaces here rather than as
    # a broken widget later.
    req = urllib.request.Request(BASE + "/targets", headers={
        "Authorization": "Bearer " + raw, "Accept": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=TIMEOUT).read()
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            return {"ok": False, "error": "Workflowy rejected that token"}
        return {"ok": False, "error": "could not verify: HTTP %s" % e.code}
    except Exception as e:
        return {"ok": False, "error": "could not reach Workflowy: %s" % str(e)[:80]}

    # Keyring first. Verification already passed above, so a token is only ever
    # written once it is known to work -- there is no window where a bad
    # credential sits in the keyring waiting to be rolled back.
    if keyring_store(raw):
        try:
            os.remove(TOKEN_FILE)      # never leave a stale plaintext copy
        except OSError:
            pass
        invalidate()                   # the cache belongs to the old account
        return {"ok": True, "sourceKind": "keyring", "source": "the OS keyring"}

    os.makedirs(os.path.dirname(TOKEN_FILE), mode=0o700, exist_ok=True)
    try:
        os.chmod(os.path.dirname(TOKEN_FILE), 0o700)
    except OSError:
        pass
    # Opened 0600 at creation: a default-mode create followed by a chmod leaves
    # the credential world-readable in between.
    tmp = TOKEN_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(raw + "\n")
    os.replace(tmp, TOKEN_FILE)
    invalidate()
    return {"ok": True, "sourceKind": "file", "source": TOKEN_FILE}


def cmd_binds(args):
    if args.op == "read":
        binds = read_binds()
        return {"ok": True, "binds": binds, "labels": BIND_LABELS,
                "order": list(BIND_ACTIONS), "conflicts": hypr_conflicts(binds),
                "file": BINDS_FILE}
    try:
        incoming = json.loads(args.json or "{}")
    except ValueError:
        return {"ok": False, "error": "bad json"}
    binds = read_binds()
    for a in BIND_ACTIONS:
        if a not in incoming:
            continue
        v = incoming[a]
        if isinstance(v, dict):
            if "enabled" in v: binds[a]["enabled"] = bool(v["enabled"])
            if v.get("key"):
                if not parse_combo(v["key"]):
                    return {"ok": False, "error": "cannot parse %r" % v["key"]}
                binds[a]["key"] = str(v["key"])
    write_binds(binds)
    reloaded = True
    try:
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    except Exception:
        reloaded = False
    return {"ok": True, "binds": binds, "reloaded": reloaded,
            "conflicts": hypr_conflicts(binds)}


def main():
    ap = argparse.ArgumentParser(prog="omaflowy")
    sub = ap.add_subparsers(dest="cmd", required=True)

    ls = sub.add_parser("list")
    ls.add_argument("source", choices=["today", "inbox", "all"])
    ls.add_argument("--date")
    ls.add_argument("--max-age", type=int, default=90,
                    help="seconds a cached export stays usable (limit is 1 req/min)")
    ls.add_argument("--exclude", default="",
                    help="comma-separated ancestor names to prune")
    ls.set_defaults(fn=cmd_list)

    c = sub.add_parser("complete")
    c.add_argument("node_id")
    c.set_defaults(fn=cmd_complete)

    au = sub.add_parser("auth")
    au.add_argument("op", choices=["status", "set", "clear"])
    au.set_defaults(fn=cmd_auth)

    bd = sub.add_parser("binds")
    bd.add_argument("op", choices=["read", "write"])
    bd.add_argument("json", nargs="?", default="{}")
    bd.set_defaults(fn=cmd_binds)

    mv = sub.add_parser("move")
    mv.add_argument("node_id")
    mv.add_argument("--date")
    mv.set_defaults(fn=cmd_move)

    a = sub.add_parser("add")
    a.add_argument("text")
    a.add_argument("--date")
    a.add_argument("--target", choices=["today", "inbox"], default="today")
    a.set_defaults(fn=cmd_add)

    args = ap.parse_args()
    out = args.fn(args)
    json.dump(out, sys.stdout)
    sys.stdout.write("\n")
    return 0 if out.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
