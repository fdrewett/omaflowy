#!/usr/bin/env python3
"""omaflowy helper — the only thing in this plugin that talks to Workflowy.

The QML side runs this and parses one JSON blob. Keeping the network, the tree
walking and the classification rules here means the panel never sees a URL, a
token, or an HTML name.

Standard library only, so there is nothing to install.

The token is read at runtime from ~/.workflowy/config.json -- the file the
`wf` CLI already owns. No credential is stored in this repo or in shell.json.


Why everything reads one export
-------------------------------
The obvious design is to address each source directly: walk today's subtree,
list the inbox. That was the first implementation and it does not survive
contact with a real desktop. There is no subtree endpoint, so depth costs
requests -- one day measured 1 -> 6 -> 22 -> 65 -> 85 across four levels, ~94
per read. The bar mounts one widget per monitor, so a two-monitor refresh is
~376 requests, every cycle. Workflowy starts answering 429.

That produced the worst possible symptom. The first version treated every
failed request as an empty node, so a rate-limited walk returned "0 todos"
with ok:true, confidently, on one monitor while the other showed 3. A todo
list that hides work is worse than one that admits it is broken.

/nodes-export returns the whole account -- ~19k nodes, ~6MB -- in one request
in about 0.7s, which is faster than walking a single day was. It is limited to
ONE REQUEST PER MINUTE, so it is cached on disk, shared by every instance, and
served stale rather than risking a 429. Total cost is now at most two requests
a minute no matter how many monitors, tabs, or refreshes are in play.
"""
import argparse, datetime, errno, fcntl, html, json, os, re, sys, time
import urllib.request, urllib.error, urllib.parse


class FetchError(RuntimeError):
    """A request failed for a reason that is not "this node is empty"."""


BASE = "https://workflowy.com/api/v1"
CONFIG = os.path.expanduser("~/.workflowy/config.json")
CACHE_DIR = os.path.expanduser("~/.cache/omaflowy")
EXPORT_CACHE = os.path.join(CACHE_DIR, "export.json")
LOCK_FILE = os.path.join(CACHE_DIR, "export.lock")
TIMEOUT = 45


# --------------------------------------------------------------------------
# transport
# --------------------------------------------------------------------------

def token():
    with open(CONFIG) as fh:
        d = json.load(fh)
    return d["accounts"][d.get("activeAccount") or "default"]["token"]


def _req(method, path, payload=None, **params):
    url = BASE + path + ("?" + urllib.parse.urlencode(params) if params else "")
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + token(),
        "Content-Type": "application/json",
        "Accept": "application/json",
    })
    try:
        body = urllib.request.urlopen(req, timeout=TIMEOUT).read().decode()
        return json.loads(body) if body.strip() else {"status": "ok"}
    except urllib.error.HTTPError as e:
        return {"__error__": e.code, "body": e.read().decode()[:200]}
    except Exception as e:                                  # DNS, TLS, timeout
        return {"__error__": "network", "body": str(e)[:200]}


# --------------------------------------------------------------------------
# the export, cached on disk and shared between instances
# --------------------------------------------------------------------------

def _read_cache():
    with open(EXPORT_CACHE) as fh:
        return json.load(fh)


def export(max_age):
    """The whole account, flat. Returns (payload, stale).

    The lock matters because the bar runs one widget per monitor: without it
    both instances see a cold cache at the same moment, both call the endpoint,
    and the second one is refused. The loser waits for the winner and reads the
    file it wrote.
    """
    now = time.time()
    try:
        if now - os.stat(EXPORT_CACHE).st_mtime < max_age:
            return _read_cache(), False
    except (OSError, ValueError):
        pass

    # 0700 / 0600 throughout. The cache is a full copy of the account -- every
    # node the user has ever written -- and the default 0644 would leave that
    # readable by any other local user. This is the single most sensitive thing
    # the plugin puts on disk; the token itself never touches it.
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(CACHE_DIR, 0o700)            # tighten a directory made earlier
    except OSError:
        pass
    with open(LOCK_FILE, "a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            # Re-check under the lock: whoever we queued behind has just
            # written a fresh copy, and refetching it would be the 429.
            try:
                if time.time() - os.stat(EXPORT_CACHE).st_mtime < max_age:
                    return _read_cache(), False
            except (OSError, ValueError):
                pass

            r = _req("GET", "/nodes-export")
            if isinstance(r, dict) and not r.get("__error__") and r.get("nodes"):
                tmp = EXPORT_CACHE + ".tmp"
                # Create 0600 up front rather than chmod-ing after: between a
                # default-mode create and a later chmod, the whole account sits
                # world-readable on disk.
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as fh:
                    json.dump(r, fh)
                os.replace(tmp, EXPORT_CACHE)   # never leave a half-written cache
                return r, True is False         # fresh
            try:                                # refused: stale beats nothing
                return _read_cache(), True
            except (OSError, ValueError):
                raise FetchError("export failed: %s"
                                 % ((r or {}).get("__error__") or "unknown"))
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def invalidate():
    """Drop the cache so the next read is fresh.

    Called after a write. If the next read lands inside the one-per-minute
    window the endpoint refuses it and there is no stale copy left to fall back
    on -- which is why the panel also removes a completed row locally rather
    than waiting to be told.
    """
    try:
        os.remove(EXPORT_CACHE)
    except OSError as e:
        if e.errno != errno.ENOENT:
            raise


# --------------------------------------------------------------------------
# text
# --------------------------------------------------------------------------

TIME_RE = re.compile(r"<time[^>]*>(.*?)</time>", re.I | re.S)
TIME_EL_RE = re.compile(r"<time\b[^>]*>.*?</time>", re.I | re.S)
TIME_ATTR_RE = re.compile(r'(\w+)="([^"]*)"')
TAG_RE = re.compile(r"<[^>]+>")


def date_pills(node):
    """Every <time> pill on a node, as (date, "HH:MM" or None).

    Workflowy stores a date as a <time> element whose attributes carry the
    parts and whose body is the rendered label -- so the attributes are what to
    match on. The body is locale- and format-dependent and is only good for
    display.
    """
    out = []
    for field in ("name", "note"):
        for el in TIME_EL_RE.findall(node.get(field) or ""):
            a = dict(TIME_ATTR_RE.findall(el))
            try:
                d = datetime.date(int(a["startYear"]), int(a["startMonth"]),
                                  int(a["startDay"]))
            except (KeyError, ValueError):
                continue
            at = None
            if "startHour" in a:
                try:
                    at = "%d:%02d" % (int(a["startHour"]), int(a.get("startMinute", 0)))
                except ValueError:
                    at = None
            out.append((d, at))
    return out


def plain(name, drop_dates=False):
    """Workflowy names are HTML. Render them the way the app shows them.

    <time> pills carry their display text as the element body, so keeping that
    and dropping the attributes is what makes a date read "Wed, Sep 9, 2026"
    instead of a wall of startYear/startMonth markup.

    `drop_dates` removes the pill entirely. Under a "dated today" heading the
    label is already implied, and leaving it in gives rows that read "check in
    the gate permit Tue, Sep 8, 2026".
    """
    if not name:
        return ""
    s = TIME_EL_RE.sub("", name) if drop_dates else TIME_RE.sub(lambda m: m.group(1), name)
    return re.sub(r"\s{2,}", " ", html.unescape(TAG_RE.sub("", s))).strip()


# --------------------------------------------------------------------------
# tree
# --------------------------------------------------------------------------

class Tree:
    def __init__(self, payload):
        self.nodes = payload.get("nodes") or []
        self.by_id = {n["id"]: n for n in self.nodes}

    def trail(self, node):
        """Ancestors, outermost first. Guarded against a cycle, which would
        otherwise hang the panel rather than fail it."""
        out, cur, guard = [], node, 0
        while cur.get("parent_id") in self.by_id and guard < 32:
            cur = self.by_id[cur["parent_id"]]
            out.append(cur)
            guard += 1
        return list(reversed(out))

    def top_level(self, name):
        for n in self.nodes:
            if not n.get("parent_id") and plain(n.get("name")) == name:
                return n
        return None

    def day_node(self, date):
        """Today's calendar day node.

        Resolved with one request rather than by matching the day node's
        display name ("Tue, Sep 8, 2026"), whose format is Workflowy's to
        change and the user's locale to vary. The API accepts a bare
        "YYYY-MM-DD" as a parent, and the children it returns carry the real
        parent_id -- so one cheap list call names the node exactly.

        A 404 means the day has nothing in it yet; days are not materialised
        until something is written to them.
        """
        r = _req("GET", "/nodes", parent_id=date)
        if isinstance(r, dict) and r.get("__error__"):
            if r["__error__"] == 404:
                return None
            raise FetchError("day lookup failed: %s" % r["__error__"])
        kids = (r.get("nodes") or []) if isinstance(r, dict) else r
        return kids[0].get("parent_id") if kids else None


def item(node, trail, drop_dates=False, at=None):
    return {
        "id": node["id"],
        "text": plain(node.get("name"), drop_dates),
        "note": plain(node.get("note")),
        "path": " / ".join(plain(a.get("name"))[:28] for a in trail),
        "createdAt": node.get("createdAt"),
        "at": at or "",
    }


def found_dates(tree, day, day_id, exclude):
    """Open nodes carrying a date pill for `day` but living somewhere else.

    This is Workflowy's own "Found Dates" list, and it is the half of a day
    that the day node does not contain: a note written under last Friday that
    says "chase the gate permit [today]" is work due today and is
    nowhere near today's bullets.

    Two exclusions, both of which the app also makes and both of which showed
    up immediately in real data: the day node itself is named with its own date
    and matches trivially, and anything already under the day node is in the
    list above this one.
    """
    out = []
    for node in tree.nodes:
        if node.get("completed") or node["id"] == day_id:
            continue
        hit = next((p for p in date_pills(node) if p[0] == day), None)
        if hit is None:
            continue
        trail = tree.trail(node)
        ids = [a["id"] for a in trail]
        if day_id and day_id in ids:
            continue
        if exclude and any(
                any(x.lower() in plain(a.get("name")).lower() for x in exclude)
                for a in trail):
            continue
        row = item(node, trail[-3:], drop_dates=True, at=hit[1])
        if row["text"]:
            out.append(row)
    out.sort(key=lambda i: (i["at"] == "", i["at"]))
    return out


def is_todo(node):
    return (node.get("data") or {}).get("layoutMode") == "todo"


def collect(tree, root_id, todos_only, exclude, relative_to=None):
    """Open items under `root_id`.

    `todos_only` is what separates the day view from the inbox view. Under a
    day node, layoutMode == "todo" is the only reliable signal for work: the
    day is also where narrative gets written, and a recurring template can
    stamp a dozen empty section headers into it, every one of them technically
    an open bullet. The Inbox is the opposite -- nothing there is
    todo-formatted, because being in the Inbox is itself the claim that
    something needs doing. Applying the day rule to it returns nothing at all.

    A completed ANCESTOR does not hide an open todo. Pruning those subtrees
    looked right while plain bullets were in scope, and was wrong for todos:
    ticking off "Tuesday plan — 8 Sep" swallowed two unticked todos that
    Workflowy itself still lists as open.
    """
    out = []
    for node in tree.nodes:
        if node.get("completed"):
            continue
        if todos_only and not is_todo(node):
            continue
        trail = tree.trail(node)
        ids = [a["id"] for a in trail]
        if root_id not in ids:
            continue
        if exclude and any(
                any(x.lower() in plain(a.get("name")).lower() for x in exclude)
                for a in trail):
            continue
        # Paths are shown relative to the view: under Today, the day node and
        # everything above it is context the header already gives.
        cut = ids.index(relative_to) + 1 if relative_to in ids else 0
        row = item(node, trail[cut:][-3:])
        if row["text"]:
            out.append(row)
    return out


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def envelope(source, label, items, stale, found=None):
    return {"ok": True, "source": source, "label": label, "items": items,
            "found": found or [], "count": len(items), "stale": stale,
            "fetchedAt": int(time.time())}


def config_error(e):
    if isinstance(e, FileNotFoundError):
        return "no ~/.workflowy/config.json — run `wf` to log in"
    return "no token in ~/.workflowy/config.json"


def cmd_list(args):
    exclude = [x.strip() for x in (args.exclude or "").split(",") if x.strip()]
    try:
        payload, stale = export(args.max_age)
        tree = Tree(payload)

        if args.source == "today":
            day = args.date or datetime.date.today().isoformat()
            day_date = datetime.date.fromisoformat(day)
            day_id = tree.day_node(day)
            found = found_dates(tree, day_date, day_id, exclude)
            if not day_id or day_id not in tree.by_id:
                # Either nothing has been written to today yet, or the day node
                # is newer than the cached export. Neither is an error -- and
                # found dates still stand on their own.
                return envelope("today", day, [], stale, found)
            items = collect(tree, day_id, True, exclude, relative_to=day_id)
            items.sort(key=lambda i: i.get("createdAt") or 0)
            return envelope("today", day, items, stale, found)

        if args.source == "inbox":
            inbox = tree.top_level("Inbox")
            if not inbox:
                return {"ok": False, "error": "no top-level Inbox found"}
            items = collect(tree, inbox["id"], False, exclude)
            items.sort(key=lambda i: i.get("createdAt") or 0, reverse=True)
            return envelope("inbox", "Inbox", items, stale)

        items = []
        for node in tree.nodes:
            if node.get("completed") or not is_todo(node):
                continue
            trail = tree.trail(node)
            if exclude and any(
                    any(x.lower() in plain(a.get("name")).lower() for x in exclude)
                    for a in trail):
                continue
            row = item(node, trail[-3:])
            if row["text"]:
                items.append(row)
        items.sort(key=lambda i: i.get("createdAt") or 0, reverse=True)
        return envelope("all", "All open todos", items, stale)

    except (FileNotFoundError, KeyError) as e:
        return {"ok": False, "error": config_error(e)}
    except RuntimeError as e:                       # FetchError included
        return {"ok": False, "error": str(e)}


def cmd_complete(args):
    r = _req("POST", "/nodes/%s/complete" % args.node_id)
    if isinstance(r, dict) and r.get("__error__"):
        return {"ok": False, "error": "%s %s" % (r["__error__"], r.get("body", ""))}
    invalidate()
    return {"ok": True, "id": args.node_id}


def cmd_move(args):
    """Move a node under a day node and make it a todo.

    Both halves matter. Moving alone would file an Inbox bullet under today and
    then hide it, because the Today tab only shows todo-formatted items -- the
    thing would vanish from both lists. Setting layoutMode on an EXISTING node
    is something only the public API can do; the MCP server ignores
    `block_format` on replace.

    A move against a bare "YYYY-MM-DD" materialises the day node if it does not
    exist yet.
    """
    day = args.date or datetime.date.today().isoformat()
    r = _req("POST", "/nodes/%s/move" % args.node_id,
             {"parent_id": day, "position": "bottom"})
    if isinstance(r, dict) and r.get("__error__"):
        return {"ok": False, "error": "move: %s %s" % (r["__error__"], r.get("body", ""))}
    r = _req("POST", "/nodes/%s" % args.node_id, {"layoutMode": "todo"})
    if isinstance(r, dict) and r.get("__error__"):
        # It is under today either way; say so rather than claiming failure.
        invalidate()
        return {"ok": True, "warning": "moved, but layout unchanged: %s" % r["__error__"]}
    invalidate()
    return {"ok": True}


def cmd_add(args):
    text = args.text.strip()
    if not text:
        return {"ok": False, "error": "empty"}
    # "- [ ] " is the markdown marker that makes create set layoutMode:todo, so
    # anything captured here comes back as a real todo on the next refresh
    # instead of an untyped bullet. Markdown is only parsed on create.
    if not text.startswith("- [ ]"):
        text = "- [ ] " + text
    # POST against a bare date materialises the calendar day node when today
    # has no bullets yet; a GET against the same date would 404.
    parent = "inbox" if args.target == "inbox" else (
        args.date or datetime.date.today().isoformat())
    r = _req("POST", "/nodes", {"parent_id": parent, "name": text,
                                "position": "bottom"})
    if isinstance(r, dict) and r.get("__error__"):
        return {"ok": False, "error": "%s %s" % (r["__error__"], r.get("body", ""))}
    invalidate()
    return {"ok": True}


def main():
    ap = argparse.ArgumentParser(prog="omaflowy")
    sub = ap.add_subparsers(dest="cmd", required=True)

    ls = sub.add_parser("list")
    ls.add_argument("source", choices=["today", "inbox", "all"])
    ls.add_argument("--date")
    ls.add_argument("--max-age", type=int, default=90,
                    help="seconds a cached export stays usable (limit is 1 req/min)")
    ls.add_argument("--exclude", default="",
                    help="comma-separated ancestor names to prune")
    ls.set_defaults(fn=cmd_list)

    c = sub.add_parser("complete")
    c.add_argument("node_id")
    c.set_defaults(fn=cmd_complete)

    mv = sub.add_parser("move")
    mv.add_argument("node_id")
    mv.add_argument("--date")
    mv.set_defaults(fn=cmd_move)

    a = sub.add_parser("add")
    a.add_argument("text")
    a.add_argument("--date")
    a.add_argument("--target", choices=["today", "inbox"], default="today")
    a.set_defaults(fn=cmd_add)

    args = ap.parse_args()
    out = args.fn(args)
    json.dump(out, sys.stdout)
    sys.stdout.write("\n")
    return 0 if out.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
